{
  "configVersion": 2,
  "server": {
    "host": "127.0.0.1",
    "port": 8123,
    "webRoot": "public"
  },
  "scan": {
    "basedir": "batches",
    "out": "batches-index.json",
    "ignore": [],
    "env": null
  },
  "runType": "test",
  "audit": false,
  "tenants": {},
  "urls": {
    "data": "report-validation-data.json",
    "defaultData": "report-validation-data-default.json",
    "ignore": "ignore-config-by-platform.json",
    "batches": "batches-index.json",
    "scan": "/scan",
    "help": "batch-help.json",
    "initData": "report-validation-data-init.json",
    "defaultDataMode": "default"
  },
  "ui": {
    "lang": "zh-CN",
    "theme": "light",
    "sidebarMode": "combined",
    "sidebarWidth": 280,
    "reportCatDefault": null,
    "batchDockSide": "left",
    "progressBarStyle": "status"
  },
  "features": {
    "uncomparedXpath": true,
    "uncomparedItems": true,
    "uncomparedCsv": true,
    "logs": true,
    "conversionRule": true,
    "validationRule": true,
    "excelMapping": true,
    "sourceFilter": true,
    "modalRules": true,
    "columnHover": true,
    "sidebarSearch": true,
    "sidebarTradeId": true,
    "compare": true,
    "healthOverview": true,
    "globalSearch": true,
    "keyboardShortcuts": true,
    "modalPrints": true,
    "recentBatches": true,
    "batchHelp": true
  },
  "limits": {
    "pageSize": 20,
    "pageSizeOptions": [
      10,
      20,
      50
    ],
    "sidebarPageSize": 8,
    "msgPageSize": 20,
    "globalSearchLimit": 200
  },
  "batches": {
    "recentCount": 5,
    "pageSize": 8,
    "listMode": "lazy",
    "detailMode": "quick",
    "panelWidth": 320
  },
  "columns": {
    "default": {
      "channel": true,
      "source": true,
      "field": true,
      "userTag": true,
      "eoEl": false,
      "aoEl": false,
      "eoCvtEl": false,
      "aoCvtEl": false,
      "vdtEl": false,
      "type": false,
      "ctxs": false,
      "eoUnconverted": false,
      "eo": true,
      "aoUnconverted": false,
      "ao": true,
      "result": true,
      "remarks": false
    },
    "labels": {
      "aoEl": { "zh-CN": "表达式 (CMP-R)", "zh-HK": "表達式 (CMP-R)", "en": "Expression (CMP-R)" },
      "eoEl": { "zh-CN": "表达式 (CMP-L)", "zh-HK": "表達式 (CMP-L)", "en": "Expression (CMP-L)" },
      "eoCvtEl": { "zh-CN": "表达式 (CVT-L)", "zh-HK": "表達式 (CVT-L)", "en": "Expression (CVT-L)" },
      "aoCvtEl": { "zh-CN": "表达式 (CVT-R)", "zh-HK": "表達式 (CVT-R)", "en": "Expression (CVT-R)" },
      "vdtEl": { "zh-CN": "表达式 (VDT)", "zh-HK": "表達式 (VDT)", "en": "Expression (VDT)" },
      "eoUnconverted": { "zh-CN": "期望值 (EO-U)", "zh-HK": "期望值 (EO-U)", "en": "Expected (EO-U)" },
      "aoUnconverted": { "zh-CN": "期望值 (AO-U)", "zh-HK": "期望值 (AO-U)", "en": "Expected (AO-U)" }
    },
    "selector": {
      "aoEl": true,
      "eoEl": true,
      "eoCvtEl": true,
      "aoCvtEl": true,
      "vdtEl": true,
      "eoUnconverted": true,
      "aoUnconverted": true
    },
    "tag": false,
    "userTag": {
      "raw": false,
      "labels": {
        "contextAssertion": { "zh-CN": "上下文断言", "zh-HK": "上下文斷言", "en": "Context Assertion" },
        "productAssertion": { "zh-CN": "产品断言", "zh-HK": "產品斷言", "en": "Product Assertion" },
        "platformAssertion": { "zh-CN": "平台断言", "zh-HK": "平台斷言", "en": "Platform Assertion" }
      }
    }
  }
}
