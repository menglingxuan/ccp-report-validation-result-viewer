{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/report-validation-config.schema.json",
  "title": "深度验证结果展示 · 统一配置 Schema",
  "description": "config.json 的结构定义。所有字段均可省略，省略时使用内置默认值。",
  "type": "object",
  "properties": {
    "server": {
      "type": "object",
      "description": "HTTP 服务配置（仅服务端使用）。",
      "properties": {
        "host": { "type": "string", "default": "127.0.0.1" },
        "port": { "type": "number", "default": 8123 },
        "webRoot": { "type": "string", "default": "public" }
      }
    },
    "scan": {
      "type": "object",
      "description": "批次扫描配置（服务端使用；basedir/out 相对租户数据根解析）。",
      "properties": {
        "basedir": { "type": "string", "default": "batches" },
        "out": { "type": "string", "default": "batches-index.json" },
        "ignore": { "type": "array", "items": { "type": "string" }, "default": [] },
        "env": { "type": ["string", "null"], "default": null }
      }
    },
    "configVersion": {
      "type": "integer",
      "description": "配置结构版本号，用于将来迁移/兼容。当前为 2。",
      "default": 2
    },
    "runType": {
      "type": "string",
      "enum": ["dev", "test", "prod"],
      "description": "运行环境。dev/test：features 未显式配置的项默认 true（全量展示）；prod：默认 false（按需开启）。",
      "default": "dev"
    },
    "audit": {
      "type": "boolean",
      "description": "是否启用租户 active 追踪与审查日志（默认关闭；可被 --audit / --no-audit 覆盖）。",
      "default": false
    },
    "tenants": {
      "type": "object",
      "description": "租户配置：键为租户 id（--tenant 或系统用户名），值可含固定端口 port 与数据根 dataRoot。",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "port": { "type": "number", "description": "该租户的固定监听端口（0 表示随机端口）。" },
          "dataRoot": { "type": "string", "description": "该租户的数据根目录（批次/索引/收藏夹）。" }
        }
      },
      "default": {}
    },
    "urls": {
      "type": "object",
      "description": "数据/忽略规则文件的相对路径（与 HTML 同目录）。",
      "properties": {
        "data": { "type": "string", "description": "主数据文件（单文件或多文件清单）的相对路径。", "default": "report-validation-data.json" },
        "defaultData": { "type": "string", "description": "默认模板数据文件（存在时优先加载）。", "default": "report-validation-data-default.json" },
        "initData": { "type": "string", "description": "空占位数据文件（defaultDataMode=init 时加载）。", "default": "report-validation-data-init.json" },
        "defaultDataMode": { "type": "string", "description": "默认数据源：init / default / 某个批次名。", "default": "default" },
        "help": { "type": "string", "description": "docker 帮助文档内容文件。", "default": "batch-help.json" },
        "ignore": { "type": "string", "description": "忽略配置 JSON 的相对路径。", "default": "ignore-config-by-platform.json" },
        "batches": { "type": "string", "description": "批次索引 JSON（最近批次面板数据源）的相对路径。", "default": "batches-index.json" },
        "scan": { "type": "string", "description": "批次自动扫描 HTTP 接口地址（可选；不配置则跳过扫描接口，直接重新读取索引）。", "default": "/scan" }
      }
    },
    "ui": {
      "type": "object",
      "description": "界面默认项（可被浏览器 localStorage 中的用户偏好覆盖）。",
      "properties": {
        "lang": {
          "type": "string",
          "enum": ["zh-CN", "zh-HK", "en"],
          "description": "默认语言：zh-CN 简体中文 / zh-HK 繁體中文（香港）/ en English。",
          "default": "zh-CN"
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "warm", "forest", "midnight", "ocean", "graphite", "violet", "sunset", "neon", "aurora"],
          "description": "默认主题配色。",
          "default": "light"
        },
        "sidebarMode": {
          "type": "string",
          "enum": ["combined", "lazy", "pagination"],
          "description": "侧栏 item 列表加载方式：combined 虚拟滚动（一体滚动）/ lazy 懒加载 / pagination 分页。",
          "default": "combined"
        },
        "sidebarWidth": {
          "type": "number",
          "minimum": 160,
          "description": "侧栏初始宽度（像素）。",
          "default": 280
        },
        "reportCatDefault": {
          "type": ["string", "null"],
          "enum": [null, "charts", "files", "note"],
          "description": "报告信息默认展开的分类：null 收起 / charts 统计图表 / files 输入配置文件 / note 任务说明。",
          "default": null
        },
        "batchDockSide": {
          "type": "string",
          "enum": ["left", "right"],
          "description": "最近批次 dock 停靠与面板呼出方向：left 左侧 / right 右侧。",
          "default": "left"
        },
        "progressBarStyle": {
          "type": "string",
          "enum": ["status", "uniform"],
          "description": "左侧 item 列表卡片进度条样式：status 按状态着色（通过绿、有警告且无失败黄）/ uniform 统一绿色。",
          "default": "status"
        }
      }
    },
    "features": {
      "type": "object",
      "description": "功能开关（19 项，布尔）。含义详见 CONFIG.md。未显式配置时按 runType 取默认。",
      "properties": {
        "uncomparedXpath": { "type": "boolean" },
        "uncomparedItems": { "type": "boolean" },
        "uncomparedCsv": { "type": "boolean" },
        "logs": { "type": "boolean" },
        "conversionRule": { "type": "boolean" },
        "validationRule": { "type": "boolean" },
        "excelMapping": { "type": "boolean" },
        "sourceFilter": { "type": "boolean" },
        "modalRules": { "type": "boolean" },
        "columnHover": { "type": "boolean" },
        "sidebarSearch": { "type": "boolean" },
        "sidebarTradeId": { "type": "boolean" },
        "compare": { "type": "boolean" },
        "healthOverview": { "type": "boolean" },
        "globalSearch": { "type": "boolean" },
        "keyboardShortcuts": { "type": "boolean" },
        "modalPrints": { "type": "boolean" },
        "recentBatches": { "type": "boolean", "description": "是否启用「最近批次」左侧 dock + 面板。" },
        "batchHelp": { "type": "boolean", "description": "是否显示 docker 帮助图标入口。" }
      }
    },
    "batches": {
      "type": "object",
      "description": "最近批次面板的行为配置。",
      "properties": {
        "recentCount": { "type": "integer", "minimum": 1, "description": "dock 中显示的最近批次数量。", "default": 5 },
        "pageSize": { "type": "integer", "minimum": 1, "description": "批次面板列表每页条数。", "default": 8 },
        "listMode": {
          "type": "string",
          "enum": ["lazy", "pagination"],
          "description": "批次列表加载方式：lazy 懒加载（点击“加载更多”逐页追加）/ pagination 分页（页码跳转）。",
          "default": "lazy"
        },
        "detailMode": {
          "type": "string",
          "enum": ["quick", "modal"],
          "description": "批次详情交互方式：quick 单击浮动预览 + 双击加载（默认）/ modal 单击加载 + 信息图标弹窗。",
          "default": "quick"
        },
        "panelWidth": { "type": "integer", "minimum": 240, "description": "批次面板展开宽度（像素）。", "default": 320 }
      }
    },
    "limits": {
      "type": "object",
      "description": "分页与数量上限。",
      "properties": {
        "pageSize": { "type": "integer", "minimum": 1, "description": "字段比较表每页条数。", "default": 20 },
        "pageSizeOptions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "description": "每页条数的可选值。", "default": [10, 20, 50] },
        "sidebarPageSize": { "type": "integer", "minimum": 1, "description": "侧栏 item 列表每页条数。", "default": 8 },
        "msgPageSize": { "type": "integer", "minimum": 1, "description": "警告/错误/未比较等消息表每页条数。", "default": 20 },
        "globalSearchLimit": { "type": "integer", "minimum": 1, "description": "全局搜索最大返回结果数。", "default": 200 }
      }
    },
    "columns": {
      "type": "object",
      "description": "字段比较表列配置：默认可见性、显示名覆盖、列选择器可见性、XPath/CSV 标签开关。",
      "properties": {
        "default": {
          "type": "object",
          "description": "列名 → 布尔（true 显示 / false 隐藏）。可用列名：channel, source, field, userTag, eoEl, aoEl, eoCvtEl, aoCvtEl, vdtEl, type, ctxs, eoUnconverted, eo, aoUnconverted, ao, result, remarks。aoEl/eoEl 统一展示 CCP XPath（XML 渠道）与 AO CSV 字段（CSV 渠道）；eoCvtEl/aoCvtEl/vdtEl/eoUnconverted/aoUnconverted 为表达式与未转换值预览列。",
          "properties": {
            "channel": { "type": "boolean" },
            "source": { "type": "boolean" },
            "field": { "type": "boolean" },
            "userTag": { "type": "boolean" },
            "eoEl": { "type": "boolean" },
            "aoEl": { "type": "boolean" },
            "eoCvtEl": { "type": "boolean" },
            "aoCvtEl": { "type": "boolean" },
            "vdtEl": { "type": "boolean" },
            "type": { "type": "boolean" },
            "ctxs": { "type": "boolean" },
            "eoUnconverted": { "type": "boolean" },
            "eo": { "type": "boolean" },
            "aoUnconverted": { "type": "boolean" },
            "ao": { "type": "boolean" },
            "result": { "type": "boolean" },
            "remarks": { "type": "boolean" }
          }
        },
        "labels": {
          "type": "object",
          "description": "列显示名覆盖（键为列名，值为字面量或 {语言: 显示名} 多语对象）。未配置时回退到 i18n 默认标签。",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "object", "additionalProperties": { "type": "string" } }
            ]
          }
        },
        "selector": {
          "type": "object",
          "description": "列是否出现在「列选择」菜单中（true 显示 / false 隐藏）。未配置的列默认出现。",
          "additionalProperties": { "type": "boolean" }
        },
        "tag": {
          "type": "boolean",
          "description": "是否在 aoEl 单元格中显示 XPath/CSV 标签（默认 false）。",
          "default": false
        },
        "userTag": {
          "type": "object",
          "description": "用户标签列显示配置：raw 为 true 时直接显示原值（普通文本）；否则按 labels 的「值 → 显示标签」映射显示为标签样式。",
          "properties": {
            "raw": { "type": "boolean", "default": false },
            "labels": {
              "type": "object",
              "description": "值 → 显示标签 的映射，值为字面量或 {语言: 显示标签} 多语对象。未配置的键回退到 i18n 默认标签。",
              "additionalProperties": {
                "oneOf": [
                  { "type": "string" },
                  { "type": "object", "additionalProperties": { "type": "string" } }
                ]
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
